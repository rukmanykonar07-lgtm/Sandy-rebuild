# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key-here
# SUPABASE_KEY=your-anon-key-here  # optional, fallback
#
# SANDY_AUTH_KEY=long-random-string-the-frontend-sends-as-X-Sandy-Key
#
# HF_TOKEN=hf_xxx                 # only needed for HF Spaces deploy
#
# Provider keys (only fill in the ones you want enabled; caps in
# sandy_config drive rate limiting regardless of which keys are present)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# NVIDIA_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# ZHIPU_API_KEY=
# MOONSHOT_API_KEY=
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# NOVITA_API_KEY=
# DEEPINFRA_API_KEY=
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
#
# Telegram alerts (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# Twilio voice/SMS alerts (optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=